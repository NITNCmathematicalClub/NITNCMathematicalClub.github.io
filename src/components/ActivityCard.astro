---
interface Activity {
  title: string;
  date: string;
  place: string;
  description: string;
  images: string[];
}

interface Props {
  activity: Activity;
  fiscalYear: number;
}

const { activity, fiscalYear } = Astro.props;
const d = new Date(activity.date + "T00:00:00");
const dateLabel = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<article class="border-t border-line py-8">
  <div class="flex flex-col gap-6 md:flex-row">
    <div class="flex-1">
      <p class="flex flex-wrap items-center gap-3 text-xs text-sub">
        <span>{dateLabel}</span>
        <span class="rounded-full border border-line px-2.5 py-0.5 text-[11px] font-bold text-navy">
          {fiscalYear}年度
        </span>
      </p>
      <h3 class="mt-2 text-xl font-bold text-navy">{activity.title}</h3>
      <p class="mt-1 text-sm text-sub">{activity.place}</p>
      <p class="mt-3 leading-relaxed">{activity.description}</p>
    </div>
    {
      activity.images.length > 0 && (
        <div class="grid w-full grid-cols-3 gap-3 md:w-1/2">
          {activity.images.slice(0, 3).map((src, i) => (
            <img
              src={src}
              alt={`${activity.title} 画像 ${i + 1}`}
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
            />
          ))}
        </div>
      )
    }
  </div>
</article>
