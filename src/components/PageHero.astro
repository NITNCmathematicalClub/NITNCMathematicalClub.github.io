---
interface Props {
  title: string;
  label: string;
}

const { title, label } = Astro.props;
---

<section class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p class="text-[11px] font-bold tracking-[0.3em] text-gold-text">{label}</p>
    <h1 class="mt-3 text-4xl font-bold text-navy">{title}</h1>
    <span class="mt-5 block h-1 w-12 bg-gold"></span>
  </div>
</section>
