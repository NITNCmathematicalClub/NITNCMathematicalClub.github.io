---
import { fmtDots } from "../lib/date";

interface Props {
  slug: string;
  title: string;
  date: Date;
  category: string;
  tags: string[];
  description: string;
  author: { department: string; grade: number };
  image?: string;
}

const { slug, title, date, category, tags, description, author, image } = Astro.props;
---

<article class="flex h-full flex-col border border-line bg-white">
  {
    image ? (
      <img src={image} alt="" class="aspect-[16/9] w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex aspect-[16/9] w-full items-center justify-center bg-band">
        <span class="font-logo text-4xl font-bold text-navy/25">Σ</span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-bold text-gold-text">{category}</p>
    <h3 class="mt-2 text-lg font-bold leading-snug text-navy">
      <a href={`/articles/${slug}`} class="hover:underline">{title}</a>
    </h3>
    <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-sub">{description}</p>
    {tags.length > 0 && <p class="mt-3 text-xs text-sub">{tags.map((t) => `#${t}`).join(" ")}</p>}
    <p class="mt-4 flex items-center justify-between border-t border-line pt-3 text-xs text-sub">
      <span>
        {author.department} {author.grade}年
      </span>
      <span>{fmtDots(date)}</span>
    </p>
  </div>
</article>
