---
const items = [
  { href: "/introduce", label: "概要" },
  { href: "/activities", label: "活動紹介" },
  { href: "/exams", label: "過去問解説" },
  { href: "/articles", label: "記事" },
  { href: "/club-magazine", label: "部誌" },
  { href: "/contact", label: "お問い合わせ" },
];
const year = new Date().getFullYear();
---

<footer data-pagefind-ignore class="bg-dark text-hero-sub">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <p class="font-logo text-2xl font-bold text-white">数理同好会</p>
    <p class="mt-2 text-xs">沼津工業高等専門学校 数理同好会</p>
    <nav aria-label="フッターナビゲーション" class="mt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="mt-10 border-t border-dark-line pt-6 text-xs">
      © {year} Numazu Kosen Mathematics Club
    </p>
  </div>
</footer>
