---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSlider from "../components/HeroSlider.tsx";
import SectionTitle from "../components/SectionTitle.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { fmtDots } from "../lib/date";

const published = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestNews = published.filter((e) => e.data.category === "お知らせ").slice(0, 3);
const latestArticles = published.filter((e) => e.data.category !== "お知らせ").slice(0, 3);

const cards = [
  {
    title: "数理同好会って何？",
    text: "実はあまり実態知られていない数理同好会.いつも何の活動をしているのか, 何をしているのか. その実態に迫ります.",
    img: "/img/Introduce/books.jpg",
    link: "/introduce",
  },
  {
    title: "部誌",
    text: "数理同好会が発行する部誌では, 部員それぞれの研究や数学に関する雑記を掲載しています.",
    img: "/img/ClubMagazine/cover.jpg",
    link: "/club-magazine",
  },
  {
    title: "過去問解説",
    text: "国立高専の入試問題（数学）の過去問を独自に解説しています. 受験生や数学好きの方はぜひご活用ください.",
    img: "/img/Activities/2025-05-11-1.jpg",
    link: "/exams",
  },
];
---

<BaseLayout title="" description="沼津高専 数理同好会の公式サイトです。活動紹介や部誌、部員による数学記事を掲載しています。">
  <HeroSlider client:load />

  <div class="bg-navy py-8 text-center">
    <p class="font-logo text-2xl font-bold text-white md:text-3xl">数理科学をこよなく愛そう</p>
  </div>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex items-end justify-between">
      <SectionTitle title="お知らせ" />
      <a href="/articles" class="shrink-0 text-sm font-bold text-gold-text hover:underline">
        一覧を見る →
      </a>
    </div>
    <ul class="mt-6 divide-y divide-line border-y border-line">
      {
        latestNews.map((entry) => (
          <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
            <span class="shrink-0 text-sm font-medium text-sub">{fmtDots(entry.data.date)}</span>
            <span class="rounded-full border border-line px-2.5 py-0.5 text-center text-[11px] font-bold text-navy">
              {entry.data.category}
            </span>
            <a href={`/articles/${entry.id}`} class="hover:underline">
              {entry.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-14">
    <div class="flex items-end justify-between">
      <SectionTitle title="最近の記事" />
      <a href="/articles" class="shrink-0 text-sm font-bold text-gold-text hover:underline">
        記事一覧へ →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        latestArticles.map((entry) => (
          <ArticleCard
            slug={entry.id}
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            tags={entry.data.tags}
            description={entry.data.description}
            author={entry.data.author}
            image={entry.data.image}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl space-y-14 px-5 pb-20">
    {
      cards.map((card, i) => (
        <div class={`flex flex-col items-center gap-8 md:flex-row ${i % 2 === 1 ? "md:flex-row-reverse" : ""}`}>
          <div class="w-full md:w-1/2">
            <img src={card.img} alt={card.title} class="aspect-video w-full object-cover" loading="lazy" />
          </div>
          <div class="w-full md:w-1/2">
            <h3 class="text-3xl font-bold text-navy">{card.title}</h3>
            <p class="mt-4 leading-relaxed text-sub">{card.text}</p>
            <a
              href={card.link}
              class="mt-6 inline-block rounded-full bg-navy px-6 py-3 font-bold text-white transition hover:bg-dark"
            >
              詳細を見る
            </a>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
