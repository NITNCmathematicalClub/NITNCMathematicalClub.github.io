---
import ArticleListPage from "../../components/ArticleListPage.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("articles", ({ data }) => !data.draft && data.category === "お知らせ")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = [...new Set(entries.flatMap((e) => e.data.tags))];
---

<ArticleListPage
  title="お知らせ"
  subtitle="同好会からのお知らせ一覧です"
  pageTitle="お知らせ"
  description="数理同好会からのお知らせ一覧です。"
  chips={[
    { label: "すべて", active: true },
    ...tags.map((t) => ({ label: t, href: `/news/tag/${encodeURIComponent(t)}` })),
  ]}
  entries={entries}
  labelFor={(e) => e.data.tags[0] ?? e.data.category}
/>
