---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticHero from "../components/StaticHero.astro";
---

<BaseLayout title="お問い合わせ" description="数理同好会へのお問い合わせ先一覧です。">
  <StaticHero title="お問い合わせ" />
  <div class="mx-auto w-full max-w-[800px] px-5 pb-16 pt-4">
    <div class="article-body">
      <h2>お問い合わせ先一覧</h2>
      <p>
        数理同好会へのお問い合わせは、以下のいずれかの方法でご連絡ください。ご質問など、お気軽にお問い合わせください。
      </p>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-line bg-white p-6">
        <h3 class="text-xl font-bold text-navy">X（旧Twitter）</h3>
        <p class="mt-3">ごくたまーに呟いています.</p>
        <a
          href="https://twitter.com/NIT_clubmath"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex items-center justify-center rounded-lg bg-navy p-4 text-lg font-semibold text-white transition hover:bg-dark"
        >
          @NIT_clubmath
        </a>
      </div>
      <div class="rounded-lg border border-line bg-white p-6">
        <h3 class="text-xl font-bold text-navy">メールアドレス</h3>
        <p class="mt-3">顧問に届きます.</p>
        <div class="mt-5 flex select-none items-center justify-center rounded-lg bg-navy p-4 text-lg font-semibold text-white">
          m-suzuki@numazu.kosen-ac.jp
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
