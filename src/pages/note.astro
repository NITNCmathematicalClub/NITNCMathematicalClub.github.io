---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticHero from "../components/StaticHero.astro";
import NoteCalendar from "../components/NoteCalendar.tsx";
import notes from "../data/notes.json";
---

<BaseLayout title="雑記帳" description="数理同好会の日々の雑記です。">
  <StaticHero title="雑記帳" />
  <div class="mx-auto w-full max-w-[800px] px-5 pb-16 pt-8">
    <img src="/img/Note/cover.jpg" alt="雑記帳" class="aspect-[3/1] w-full rounded-lg object-cover" />
    <div class="article-body mt-4">
      <h2>概要</h2>
      <p>
        その日にあったことを気軽に呟いているものです. 日々更新されていくので, 暇なときに見てみると面白いかもしれません.
      </p>
    </div>
    <div class="mt-10">
      <NoteCalendar client:load notes={notes} />
    </div>
  </div>
</BaseLayout>
