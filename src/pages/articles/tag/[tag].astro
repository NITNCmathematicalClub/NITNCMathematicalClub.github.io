---
import ArticleListPage from "../../../components/ArticleListPage.astro";
import { getArticles } from "../../../lib/content";
import { ARTICLE_TAG_LIST } from "../../../content/tags";

export async function getStaticPaths() {
  const published = (await getArticles()).filter(({ data }) => !data.draft);
  // 定義済みタグすべてにページを作る（記事が0件のタグもチップのリンク先として必要）
  return ARTICLE_TAG_LIST.map((t) => ({
    params: { tag: t.slug },
    props: {
      tag: t.slug,
      label: t.label,
      entries: published.filter((e) => e.tags.some((tag) => tag.slug === t.slug)),
    },
  }));
}

const { tag, label, entries } = Astro.props;
---

<ArticleListPage
  title={label}
  subtitle="タグの付いた記事の一覧です"
  pageTitle={`タグ: ${label}`}
  description={`タグ「${label}」の記事一覧です。`}
  chips={[
    { label: "すべて", href: "/articles" },
    ...ARTICLE_TAG_LIST.map((t) => ({
      label: t.label,
      href: t.slug === tag ? undefined : `/articles/tag/${t.slug}`,
      active: t.slug === tag,
    })),
  ]}
  entries={entries}
  showAuthor
/>
