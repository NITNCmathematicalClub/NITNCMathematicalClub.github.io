---
import ArticleListPage from "../../../components/ArticleListPage.astro";
import { getAllEntries } from "../../../lib/content";
import { ALL_CATEGORIES } from "../../../content/categories";

export async function getStaticPaths() {
  const published = (await getAllEntries()).filter(({ data }) => !data.draft);
  return ALL_CATEGORIES.map((category) => ({
    params: { category },
    props: {
      category,
      entries: published.filter((e) => e.category === category),
    },
  }));
}

const { category, entries } = Astro.props;
---

<ArticleListPage
  title={category}
  subtitle="部員が書いた記事の一覧です"
  pageTitle={`カテゴリ: ${category}`}
  description={`カテゴリ「${category}」の記事一覧です。`}
  chips={[
    { label: "すべて", href: "/articles" },
    ...ALL_CATEGORIES.map((c) => ({
      label: c,
      href: c === category ? undefined : `/articles/category/${encodeURIComponent(c)}`,
      active: c === category,
    })),
  ]}
  entries={entries}
  labelFor={(e) => e.category}
  showAuthor
/>
