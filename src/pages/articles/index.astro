---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../../content.config";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="記事" description="数理同好会の部員による記事の一覧です。">
  <PageHero title="記事" label="ARTICLES" />
  <div class="mx-auto max-w-6xl px-5 py-12">
    <nav aria-label="カテゴリ" class="flex flex-wrap gap-2">
      <span class="rounded-full bg-navy px-4 py-1.5 text-sm font-bold text-white">すべて</span>
      {
        CATEGORIES.map((c) => (
          <a
            href={`/articles/category/${encodeURIComponent(c)}`}
            class="rounded-full border border-line px-4 py-1.5 text-sm font-bold text-navy hover:bg-band"
          >
            {c}
          </a>
        ))
      }
    </nav>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((entry) => (
          <ArticleCard
            slug={entry.id}
            title={entry.data.title}
            date={entry.data.date}
            category={entry.data.category}
            tags={entry.data.tags}
            description={entry.data.description}
            author={entry.data.author}
            image={entry.data.image}
          />
        ))
      }
    </div>
    {articles.length === 0 && <p class="mt-10 text-sub">記事はまだありません。</p>}
  </div>
</BaseLayout>
