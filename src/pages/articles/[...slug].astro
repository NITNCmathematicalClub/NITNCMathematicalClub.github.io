---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import SimpleLayout from "../../layouts/SimpleLayout.astro";
import { getAllEntries } from "../../lib/content";

export async function getStaticPaths() {
  const all = await getAllEntries();
  const published = all.filter(({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return published.map((entry, i) => {
    const newer = published[i - 1];
    const older = published[i + 1];
    const related = all
      .filter((e) => e.slug !== entry.slug && !e.data.draft && e.category === entry.category)
      .slice(0, 3);
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prev: older ? { slug: older.slug, title: older.data.title } : null,
        next: newer ? { slug: newer.slug, title: newer.data.title } : null,
        related,
      },
    };
  });
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry.raw);
const d = entry.data;

// 年度（4月始まり）
const fiscalYear = (date: Date) =>
  date.getUTCMonth() >= 3 ? date.getUTCFullYear() : date.getUTCFullYear() - 1;
---

{
  entry.kind === "news" ? (
    <SimpleLayout
      title={d.title}
      date={d.date}
      label={entry.category}
      description={d.description}
      backHref="/news"
      backLabel="お知らせ一覧へ戻る"
    >
      <Content />
    </SimpleLayout>
  ) : entry.kind === "report" ? (
    <SimpleLayout
      title={d.title}
      date={d.date}
      label={`${fiscalYear(d.date)}年度`}
      description={d.description}
      backHref="/activities"
      backLabel="活動報告一覧へ戻る"
    >
      <Content />
    </SimpleLayout>
  ) : (
    <ArticleLayout
      title={d.title}
      date={d.date}
      category={entry.category}
      tags={d.tags}
      author={d.author}
      description={d.description}
      image={d.image}
      headings={headings}
      prev={prev}
      next={next}
      related={related}
    >
      <Content />
    </ArticleLayout>
  )
}
