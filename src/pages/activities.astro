---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ActivityCard from "../components/ActivityCard.astro";
import activities from "../data/activities.json";

const fiscalYear = (iso: string) => {
  const d = new Date(iso + "T00:00:00");
  return d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1;
};

const sorted = [...activities].sort((a, b) => b.date.localeCompare(a.date));
const years = [...new Set(sorted.map((a) => fiscalYear(a.date)))].sort((a, b) => b - a);
---

<BaseLayout title="活動紹介" description="数理同好会の活動の記録を年度別に紹介します。">
  <PageHero title="活動紹介" label="ACTIVITIES" />
  <div class="mx-auto max-w-6xl px-5 py-12">
    <nav aria-label="年度" class="flex flex-wrap gap-2">
      {
        years.map((y) => (
          <a
            href={`#year-${y}`}
            class="rounded-full border border-line px-4 py-1.5 text-sm font-bold text-navy hover:bg-band"
          >
            {y}年度
          </a>
        ))
      }
    </nav>
    {
      years.map((y) => (
        <section id={`year-${y}`} class="mt-12 scroll-mt-24">
          <h2 class="text-2xl font-bold text-navy">
            {y}年度
            <span class="mt-3 block h-0.5 w-10 bg-gold" />
          </h2>
          <div>
            {sorted
              .filter((a) => fiscalYear(a.date) === y)
              .map((a) => (
                <ActivityCard activity={a} fiscalYear={y} />
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
