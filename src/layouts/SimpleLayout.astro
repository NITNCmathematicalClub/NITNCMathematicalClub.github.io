---
import BaseLayout from "./BaseLayout.astro";
import { fmtISO } from "../lib/date";

// お知らせ・活動報告の詳細（Figma テンプレート: 幅800の単カラム、末尾に一覧へ戻るリンク）
interface Props {
  title: string;
  date: Date;
  description: string;
  backHref: string;
  backLabel: string;
}

const { title, date, description, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-[800px] px-5 pb-16 pt-12">
    <p class="flex items-baseline gap-4 text-xs">
      <span class="text-sub">{fmtISO(date)}</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold leading-snug text-ink">{title}</h1>
    <hr class="mt-6 border-line" />
    <div class="article-body mt-8">
      <slot />
    </div>
    <p class="mt-16 border-t border-line pt-6">
      <a href={backHref} class="text-sm font-bold text-navy hover:underline">← {backLabel}</a>
    </p>
  </div>
</BaseLayout>
