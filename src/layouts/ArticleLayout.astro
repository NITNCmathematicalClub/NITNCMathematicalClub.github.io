---
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { fmtJP } from "../lib/date";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedEntry {
  id: string;
  data: {
    title: string;
    date: Date;
    category: string;
    tags: string[];
    description: string;
    author: { department: string; grade: number };
    image?: string;
  };
}

interface Props {
  title: string;
  date: Date;
  category: string;
  tags: string[];
  author: { department: string; grade: number };
  description: string;
  image?: string;
  headings: Heading[];
  prev?: { id: string; title: string } | null;
  next?: { id: string; title: string } | null;
  related: RelatedEntry[];
}

const { title, date, category, tags, author, description, image, headings, prev, next, related } =
  Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-12">
      <article class="mx-auto w-full max-w-[800px]">
        <p class="text-xs font-bold tracking-widest text-gold-text">{category}</p>
        <h1 class="mt-3 text-3xl font-bold leading-snug text-navy md:text-4xl">{title}</h1>
        <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-sub">
          <span>{fmtJP(date)}</span>
          <span>
            {author.department} {author.grade}年
          </span>
          {
            tags.map((t) => (
              <a href={`/articles/tag/${encodeURIComponent(t)}`} class="text-gold-text hover:underline">
                #{t}
              </a>
            ))
          }
        </p>
        {image && <img src={image} alt="" class="mt-8 w-full object-cover" />}

        {
          toc.length > 0 && (
            <details class="mt-8 border border-line bg-white p-5 lg:hidden">
              <summary class="cursor-pointer font-bold text-navy">目次</summary>
              <ul class="mt-3 space-y-2 text-sm">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "pl-4" : ""}>
                    <a href={`#${h.slug}`} class="text-sub hover:text-navy">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <div class="article-body mt-10">
          <slot />
        </div>

        <nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="前後の記事">
          {
            prev ? (
              <a href={`/articles/${prev.id}`} class="group">
                <span class="text-xs text-sub">← 前の記事</span>
                <span class="mt-1 block font-bold text-navy group-hover:underline">{prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`/articles/${next.id}`} class="group text-right">
                <span class="text-xs text-sub">次の記事 →</span>
                <span class="mt-1 block font-bold text-navy group-hover:underline">{next.title}</span>
              </a>
            )
          }
        </nav>
      </article>

      {
        toc.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <p class="text-xs font-bold tracking-widest text-sub">CONTENTS</p>
              <ul class="mt-4 space-y-2.5 border-l border-line pl-4 text-sm" id="toc-rail">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "pl-4" : ""}>
                    <a href={`#${h.slug}`} data-toc={h.slug} class="text-sub transition hover:text-navy">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>

    {
      related.length > 0 && (
        <section class="mx-auto mt-20 max-w-[800px] lg:mx-0">
          <h2 class="text-2xl font-bold text-navy">
            関連記事
            <span class="mt-3 block h-0.5 w-10 bg-gold" />
          </h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((entry) => (
              <ArticleCard
                slug={entry.id}
                title={entry.data.title}
                date={entry.data.date}
                category={entry.data.category}
                tags={entry.data.tags}
                description={entry.data.description}
                author={entry.data.author}
                image={entry.data.image}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script>
    const links = document.querySelectorAll<HTMLElement>("[data-toc]");
    if (links.length > 0) {
      const map = new Map<string, HTMLElement>();
      links.forEach((l) => map.set(l.dataset.toc ?? "", l));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove("font-bold", "text-gold-text"));
              const active = map.get(e.target.id);
              active?.classList.add("font-bold", "text-gold-text");
            }
          }
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      document
        .querySelectorAll(".article-body h2, .article-body h3")
        .forEach((h) => observer.observe(h));
    }
  </script>
</BaseLayout>
