---
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";
import RelatedCard from "../components/RelatedCard.astro";
import { fmtISO } from "../lib/date";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedEntry {
  slug: string;
  tagLabels: string[];
  data: {
    title: string;
    date: Date;
  };
}

interface Props {
  title: string;
  date: Date;
  tags: { slug: string; label: string }[];
  author: { department: string; grade: number };
  description: string;
  image?: string;
  headings: Heading[];
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
  related: RelatedEntry[];
}

const { title, date, tags, author, description, image, headings, prev, next, related } =
  Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,800px)_240px] lg:gap-14">
      <article class="w-full">
        <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs">
          <span class="text-sub">{fmtISO(date)}</span>
        </p>
        <h1 class="mt-3 text-3xl font-bold leading-snug text-ink md:text-4xl">{title}</h1>
        <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-line pb-6 text-sm text-sub">
          <span>
            {author.department} {author.grade}年
          </span>
          {
            tags.map((t) => (
              <a
                href={`/articles/tag/${encodeURIComponent(t.slug)}`}
                class="font-bold text-gold-text hover:underline"
              >
                #{t.label}
              </a>
            ))
          }
        </p>

        {
          image ? (
            <img src={image} alt="" class="mt-8 aspect-[16/9] w-full rounded-lg object-cover" />
          ) : (
            <div class="mt-8 aspect-[16/9] w-full rounded-lg bg-band" aria-hidden="true" />
          )
        }

        {
          toc.length > 0 && (
            <details class="mt-8 rounded-lg border border-line bg-white p-5 lg:hidden">
              <summary class="cursor-pointer font-bold text-ink">目次</summary>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "ml-4" : ""}>
                    <a href={`#${h.slug}`} class="text-sub hover:text-navy">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="article-body mt-10">
          <slot />
        </div>

        <nav class="mt-16 flex items-start justify-between gap-6 border-t border-line pt-6" aria-label="前後の記事">
          {
            prev ? (
              <a href={`/articles/${prev.slug}`} class="group max-w-[45%]">
                <span class="text-xs text-sub">← 前の記事</span>
                <span class="mt-1 block font-bold text-ink group-hover:underline">{prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`/articles/${next.slug}`} class="group max-w-[45%] text-right">
                <span class="text-xs text-sub">次の記事 →</span>
                <span class="mt-1 block font-bold text-ink group-hover:underline">{next.title}</span>
              </a>
            )
          }
        </nav>

        {
          related.length > 0 && (
            <section class="mt-16">
              <h2 class="text-xl font-bold text-ink">関連記事</h2>
              <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {related.map((entry) => (
                  <RelatedCard
                    slug={entry.slug}
                    title={entry.data.title}
                    date={entry.data.date}
                    labels={entry.tagLabels}
                  />
                ))}
              </div>
            </section>
          )
        }
      </article>

      {
        toc.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <p class="text-sm font-bold text-ink">
                <span class="mb-2 block h-0.5 w-6 bg-gold" />
                目次
              </p>
              <ol class="mt-4 list-decimal space-y-2.5 pl-5 text-sm" id="toc-rail">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "ml-4" : ""}>
                    <a href={`#${h.slug}`} data-toc={h.slug} class="text-sub transition hover:text-navy">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
    </div>
  </div>

  <script>
    const links = document.querySelectorAll<HTMLElement>("[data-toc]");
    if (links.length > 0) {
      const map = new Map<string, HTMLElement>();
      links.forEach((l) => map.set(l.dataset.toc ?? "", l));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove("font-bold", "text-gold-text"));
              const active = map.get(e.target.id);
              active?.classList.add("font-bold", "text-gold-text");
            }
          }
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      document
        .querySelectorAll(".article-body h2, .article-body h3")
        .forEach((h) => observer.observe(h));
    }
  </script>
</BaseLayout>
